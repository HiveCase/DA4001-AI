kdown","source":"## 2. Finding the right predictor\n\nWe build a `Open_next` feature = the *next* row's `Open`, and compare predictors on a **time-based holdout** that mimics the real test setup.","metadata":{}},{"cell_type":"code","source":"def rmse(a, b):\n    return float(np.sqrt(np.mean((np.asarray(a) - np.asarray(b)) ** 2)))\n\ntrain_df['Open_next'] = train_df['Open'].shift(-1)   # tomorrow's open\n\ncut  = len(train_df) - 300\nbase = train_df.iloc[:cut].dropna(subset=['Open_next'])\nval  = train_df.iloc[cut:].dropna(subset=['Open_next'])\n\nFEATS = ['Open', 'Open_next']\nprint(f\"Close_t ~ Open_t (same day)     RMSE = {rmse(val.Close, val.Open):.3f}\")\nprint(f\"Close_t ~ Open_(t+1) (next day) RMSE = {rmse(val.Close, val.Open_next):.3f}\")\n\n# --- Polynomial Regression, degree 2 ---\nm_lin  = LinearRegression().fit(base[FEATS], base.Close)\nm_poly = make_pipeline(PolynomialFeatures(degree=2, include_bias=False),\n                       LinearRegression()).fit(base[FEATS], base.Close)\npred_lin  = m_lin.predict(val[FEATS])\npred_poly = m_poly.predict(val[FEATS])\nprint(f\"Linear      [Open, Open_next]   RMSE = {rmse(val.Close, pred_lin):.3f}\")\nprint(f\"Polynomial  degree 2            RMSE = {rmse(val.Close, pred_poly):.3f}\")\n\npred_val = pred_poly   # used by the plot below","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-25T06:29:40.841034Z","iopub.execute_input":"2026-08-25T06:29:40.841341Z","iopub.status.idle":"2026-08-25T06:29:40.873762Z","shell.execute_reply.started":"2026-08-25T06:29:40.841311Z","shell.execute_reply":"2026-08-25T06:29:40.87252Z"}},"outputs":[{"name":"stdout","text":"Close_t ~ Open_t (same day)     RMSE = 16.867\nClose_t ~ Open_(t+1) (next day) RMSE = 13.330\nLinear      [Open, Open_next]   RMSE = 12.550\nPolynomial  degree 2            RMSE = 12.341\n","output_type":"stream"}],"execution_count":27},{"cell_type":"code","source":"fig, ax = plt.subplots(figsize=(12, 4))\nax.plot(val.date, val.Close, label='actual Close', lw=1)\nax.plot(val.date, pred_val,  label='predicted', lw=1, alpha=0.8)\nax.set_title('Holdout: Polynomial deg-2 predicted vs actual Close'); ax.legend(); plt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-25T06:29:40.875644Z","iopub.execute_input":"2026-08-25T06:29:40.875973Z","iopub.status.idle":"2026-08-25T06:29:41.104537Z","shell.execute_reply.started":"2026-08-25T06:29:40.875944Z","shell.execute_reply":"2026-08-25T06:29:41.103374Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"<Figure size 1200x400 with 1 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":28},{"cell_type":"markdown","source":"The next-day `Open` gives a big jump in accuracy because it's essentially a delayed peek at today's `Close`. The regression on both opens is the most robust and needs no manual tuning.","metadata":{}},{"cell_type":"markdown","source":"## 3. Fit on full train & predict the test set","metadata":{}},{"cell_type":"code","source":"FEATS = ['Open', 'Open_next']\ntrain_fit = train_df.dropna(subset=['Open_next'])\n\n# Polynomial Regression, degree 2\nmodel = make_pipeline(PolynomialFeatures(degree=2, include_bias=False),\n                      LinearRegression()).fit(train_fit[FEATS], train_fit.Close)\nlin = model.named_steps['linearregression']\nprint('Poly-2 coeffs:', np.round(lin.coef_, 6), '| intercept:', round(lin.intercept_, 4))\n\n# Build the same features for the test set: next-day open comes from the next test row.\ntest_df['Open_next'] = test_df['Open'].shift(-1)\ntest_df['Open_next'] = test_df['Open_next'].fillna(test_df['Open'])\n\ntest_df['Close'] = model.predict(test_df[FEATS])\ntest_df[['date', 'Open', 'Open_next', 'Close']].head()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-25T06:29:41.105544Z","iopub.execute_input":"2026-08-25T06:29:41.105812Z","iopub.status.idle":"2026-08-25T06:29:41.134228Z","shell.execute_reply.started":"2026-08-25T06:29:41.105787Z","shell.execute_reply":"2